{
  "name": "breach-and-defend",
  "version": "1.0.0",
  "private": true,
  "description": "A red-versus-blue cybersecurity card game",
  "keywords": ["cybersecurity", "card-game", "browser-game", "education", "red-team", "blue-team"],
  "homepage": "https://breach.cards/",
  "bugs": "https://github.com/FrodeHus/breach-and-defend/issues",
  "repository": { "type": "git", "url": "git+https://github.com/FrodeHus/breach-and-defend.git" },
  "license": "MIT",
  "author": "Frode Hus (https://www.frodehus.dev)",
  "scripts": {
    "start": "node serve.cjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "npx --yes -p typescript@5.9.3 tsc -p jsconfig.json",
    "playtest": "node tests/helpers/playtest-cli.mjs",
    "format": "npx --yes prettier@3.9.9 --write \"public/**/*.{mjs,css,html}\" \"tests/**/*.mjs\" serve.cjs",
    "format:check": "npx --yes prettier@3.9.9 --check \"public/**/*.{mjs,css,html}\" \"tests/**/*.mjs\" serve.cjs"
  },
  "engines": { "node": ">=22" }
}
